# MergeGate configuration.
#
# Copy to .env (gitignored) and fill in. Nothing here should ever be committed;
# in deployment these live in GCP Secret Manager and .env is local-only.
#
# Tiers:
#   [P0.1]  blocks the eligibility gate; without these there is no submission
#   [HOST]  blocks GCP deployment and the pinned verifier image digest
#   [DEMO]  blocks the two demo flows end to end
#   [P2.2]  blocks the x402 verifier-fee binding (nice-to-have, not existential)


# =============================================================================
# [P0.1] Circle: agent-funded escrow (CLI Agent Wallets)
# =============================================================================
# MergeGate settles through Circle AGENT WALLETS, driven by the `circle` CLI,
# NOT the REST Developer-Controlled Wallets API. They are separate products
# holding separate wallets: the funded Base mainnet addresses exist only in the
# former, and a REST API key cannot see or spend them.
#
# There is therefore no CIRCLE_API_KEY, no entity secret, and no wallet set here.
# Auth is an email OTP session established by `circle login`, which provisions a
# credential once the way a service account does. Every transfer after that is
# agent-initiated with no human action, which is what the prize rule requires.
#
# Path to the CLI. Blank means: $CIRCLE_CLI_PATH, then ~/.local/bin/circle,
# then PATH. Cloud Run receives the session as a base64 tarball unpacked at
# startup; keep it in Secret Manager, not a plain env var: it is a bearer
# credential.
CIRCLE_CLI_PATH=
CIRCLE_SESSION_B64=

# Agent wallet addresses. MergeGate needs its OWN four wallets rather than
# sharing the "Verigate Security Treasury" set: receipts name the wallets, and
# two submissions settling from one treasury muddles both.
#
# The verifier-fee wallet must be DISTINCT from the provider wallet. If they are
# the same address, "escrow pays the verifier service" is two transfers to one
# beneficiary, and the executor skips the fee rather than overstate it.
BUYER_AGENT_ADDRESS=
PROVIDER_AGENT_ADDRESS=
ESCROW_ADDRESS=

# BASE for mainnet, BASE-SEPOLIA for a dry run. Every flow works on either;
# only mainnet counts for the prize. Rehearse on Sepolia, then flip this.
CIRCLE_BLOCKCHAIN=BASE
# Base mainnet USDC. Verify before use: a wrong address silently sends nothing.
USDC_CONTRACT_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# The spend policy governing the buyer wallet. Recorded for the receipt and the
# docs: it is what backs the claim that funding happens under a wallet policy.
CIRCLE_WALLET_POLICY=

# How much USDC the demo actually moves per task. Keep it small: both flows run
# for real, and while the refund flow returns its own funds, the release flow
# does not: that USDC leaves the buyer wallet permanently.
#
# At 0.25 the buyer's 2.64 USDC funds ten release rehearsals; at 1.00 it funds
# two. The number is nominal to the proof either way: what a judge checks is
# that a real transaction settled against a real verdict, not its size.
DEMO_REWARD_USDC=0.25


# =============================================================================
# [HOST] Google Cloud: verifier, API, evidence
# =============================================================================
GOOGLE_CLOUD_PROJECT=
GCP_REGION=us-central1

# Artifact Registry repo holding the verifier image. Contracts pin this image
# BY DIGEST, so the digest below is produced by an actual build+push; it is not
# something to invent. Currently a placeholder everywhere.
ARTIFACT_REGISTRY_REPO=mergegate
VERIFIER_IMAGE_DIGEST=

# GCS bucket for evidence (manifests, receipts, command output).
EVIDENCE_BUCKET=

# Ed25519 receipt signing key. MergeGate uses its own rather than reusing the
# shared engine's, so a compromise of one cannot forge receipts under the other.
# The PRIVATE half lives only here and in the verifier; the deployed API holds
# only the public half. See MERGEGATE_RECEIPT_PUBLIC_KEY at the bottom.
MERGEGATE_SIGNING_KEY_SECRET=mergegate-signing-key


# =============================================================================
# [DEMO] GitHub: the submission surface
# =============================================================================
# The repo the provider agent submits against. Should be one you can force-push
# to, because the P0.4 demo depends on it.
DEMO_REPO=4KInc/mergegate-demo-task
# Base commit the contract pins. Current head of that repo:
DEMO_BASE_SHA=3476768e6dff4d7a39c3ae3fef2f188ab6ffddb8
# Read access to commits and diffs. A fine-grained PAT scoped to that one repo
# is enough; a GitHub App is cleaner if you already have one.
GITHUB_TOKEN=
# Shared secret for webhook signature verification.
GITHUB_WEBHOOK_SECRET=


# =============================================================================
# [P2.2] x402 / Circle Gateway: verifier-as-a-paid-service
# =============================================================================
# Escrow pays the verifier a micro-fee per run; that tx binds into the receipt
# alongside the settlement tx, making Circle central in two places.
# Leave blank if Gateway access is not available: the receipt field exists and
# is bound, it just stays empty, and the README says so.
X402_ENDPOINT=
X402_API_KEY=
# Must differ from PROVIDER_AGENT_ADDRESS. See the note above.
VERIFIER_FEE_WALLET_ADDRESS=
VERIFIER_FEE_USDC=0.05


# =============================================================================
# [ADVISORY] Gemini. Around the settlement path, never inside it.
# =============================================================================
# Optional in the strongest sense: with this unset, MergeGate settles exactly as
# it always has. The advisory layer reports itself unavailable and the pages say
# nothing looked, rather than showing an empty panel that reads like a clean
# result.
#
# What it does: screens the provider's diff for malicious code, supply chain
# risk and test gaming before the sandbox runs, and explains a FAIL afterwards
# so a provider agent knows whether retrying is worth it.
#
# What it cannot do: change a verdict, release or withhold escrow, or enter a
# signed receipt. That is enforced by tests, not by convention:
# tests/test_gemini_boundary.py asserts the settlement modules do not import it,
# that settlement is identical for every possible model output including a
# hostile one, and that a diff which successfully manipulates the screening
# still settles the same way. The diff is written by the party being judged, so
# manipulation is assumed; it is acceptable because it buys nothing.
#
# Needs the optional extra: pip install -e ".[gemini]"
GEMINI_API_KEY=


# =============================================================================
# [INTEGRATE] What a third party needs, and nothing more
# =============================================================================
# Everything above is what an operator needs to RUN MergeGate. The two below are
# all anyone needs to CHECK it, which is the asymmetry the design is aiming for:
# verifying a receipt requires no credential, no account, and no permission.
#
# The PUBLIC half of the receipt signing key, base64url. Publishing it is the
# entire point of signing: without it, "independently verifiable" is a claim
# nobody outside the deployment can exercise. The service also serves it at
# /api/verification-key, with the caveat that a key taken from the issuer proves
# self-consistency rather than honesty. Pin it out of band.
MERGEGATE_RECEIPT_PUBLIC_KEY=

# Which deployment the CLI and the MCP server talk to. Only affects where
# receipts are fetched from; verification itself is local and offline.
MERGEGATE_SERVICE=https://mergegate-api-1031148889398.us-central1.run.app
