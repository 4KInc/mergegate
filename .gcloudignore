# Build context for the API image. Keep secrets and local state out.
.venv/
.git/
.env
.env.*
!.env.example
design/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/
tests/
# Leading slash matters: a bare "verifier/" also matches mergegate/verifier/,
# which silently dropped that subpackage from the image. Nothing imported it at
# runtime until the dashboard did, so the omission went unnoticed.
/verifier/
